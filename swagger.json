{
  "swagger": "2.0",
  "info": {
    "title": "Centralized Health Information Exchange System API",
    "version": "1.0.0",
    "description": "API documentation for the Centralized Health Information Exchange System"
  },
  "host": "localhost:5000",
  "basePath": "/api",
  "schemes": ["http"],
  "paths": {
    "/patients": {
      "post": {
        "summary": "Create a new patient",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Patient object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Patient"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Patient created"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      },
      "get": {
        "summary": "Retrieve all patients",
        "responses": {
          "200": {
            "description": "List of patients"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/patients/{id}": {
      "get": {
        "summary": "Retrieve a patient by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Patient details"
          },
          "404": {
            "description": "Patient not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "summary": "Update a patient by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "description": "Patient object",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Patient"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Patient updated"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Patient not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "summary": "Delete a patient by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Patient deleted"
          },
          "404": {
            "description": "Patient not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "definitions": {
    "Patient": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "age": {
          "type": "integer"
        },
        "gender": {
          "type": "string"
        },
        "contactInfo": {
          "type": "string"
        },
        "medicalHistory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
